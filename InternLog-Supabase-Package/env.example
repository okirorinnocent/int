# ───────── InternLog environment variables ─────────
# Local: copy to .env.local        Vercel: Project -> Settings -> Environment Variables
# After changing any value on Vercel you must REDEPLOY for it to take effect.

# ── Supabase (Dashboard -> Project Settings -> API / API Keys) ──
# Public: ends up in the browser, safe by design (Row Level Security protects the data).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx      # (or the legacy "anon" key)

# Same two values again for server functions (they verify the signed-in user's token).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ── InternAI (this is what fixes "AI is not configured.") ──
OPENAI_API_KEY=sk-...                  # SECRET, server only. Never prefix with VITE_
INTERNAI_MODEL=gpt-4o-mini             # optional, this is the default
INTERNAI_RULES=                        # optional: your institution's hours / report chapters / grading weights

# ── Hosting ──
NITRO_PRESET=vercel

# ── NOT needed with the new SQL (remove them if you set them) ──
# SUPABASE_SERVICE_ROLE_KEY   only add if you later build server-side admin jobs (e.g. deleting users); never expose it
# DATABASE_POOLER_URL         the app talks to Supabase through its API + RLS, not a raw Postgres connection
# INTERNAI_DB_URL             the old internai_agent database role no longer exists
